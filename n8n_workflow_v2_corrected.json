    {
      "parameters": {
        "jsCode": "// Count pending reports from both Temp and Session tabs\nconst tempItems = $('Read Temp (Status)').all();\nconst sessionItems = $('Read Session (Status)').all();\n\n// Count Temp tab (ready for JotForm submission)\nlet tempCount = 0;\nconst tempDogs = [];\nfor (const item of tempItems) {\n  if (item.json['Dog Name']) {\n    tempCount++;\n    tempDogs.push(item.json['Dog Name']);\n  }\n}\n\n// Count Session tab (in progress on website)\nlet sessionCount = 0;\nconst sessionDogs = [];\nfor (const item of sessionItems) {\n  if (item.json['Dog_ID']) {\n    sessionCount++;\n    sessionDogs.push(item.json['Matched_Name'] || item.json['Input_Name'] || 'Unknown');\n  }\n}\n\nreturn [{\n  json: {\n    tempCount,\n    tempDogs: tempDogs.slice(0, 10),\n    sessionCount,\n    sessionDogs: sessionDogs.slice(0, 10),\n    hasTempMore: tempDogs.length > 10,\n    hasSessionMore: sessionDogs.length > 10\n  }\n}];"
      },
