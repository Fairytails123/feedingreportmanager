      "id": "if-has-data-001",
      "name": "Has Data?",
      "type": "n8n-nodes-base.if",
      "position": [860, 180],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "jsCode": "// Process each row from Temp tab and prepare JotForm submission data\n// TEMP TAB COLUMNS (7 columns - NO Parent Name):\n// A: Dog Name | B: Parent Email | C: Meal | D: Food Consumed | E: Medicine Supplement | F: Supplement Types | G: Comments\n\nconst items = $input.all();\nconst results = [];\n\n// JotForm field IDs (from your form)\nconst FORM_ID = '240143730611039';\n\n// Get today's date\nconst today = new Date();\nconst day = today.getDate().toString();\nconst month = (today.getMonth() + 1).toString();\nconst year = today.getFullYear().toString();\n\nfor (const item of items) {\n  const row = item.json;\n  \n  // Skip empty rows\n  if (!row['Dog Name']) continue;\n  \n  // Build form data object for JotForm API\n  const formData = {};\n  \n  // Date (field 3)\n  formData['submission[3][day]'] = day;\n  formData['submission[3][month]'] = month;\n  formData['submission[3][year]'] = year;\n  \n  // Dog name (field 13)\n  formData['submission[13]'] = row['Dog Name'] || '';\n  \n  // Parent email (field 14)\n  formData['submission[14]'] = row['Parent Email'] || '';\n  \n  // Meal time (field 9)\n  formData['submission[9]'] = row['Meal'] || 'Lunch';\n  \n  // Food consumed (field 6)\n  formData['submission[6]'] = row['Food Consumed'] || 'All';\n  \n  // Has medicine/supplement (field 10)\n  formData['submission[10]'] = row['Medicine Supplement'] || 'No';\n  \n  // Medicine and supplements (field 7) - can be multiple\n  // Format in sheet: \"Calming Tablets, Hemp Oil\" -> split to array\n  const suppTypes = row['Supplement Types'] || '';\n  if (suppTypes) {\n    const supps = suppTypes.split(',').map(s => s.trim()).filter(s => s);\n    supps.forEach((supp, idx) => {\n      formData[`submission[7][${idx}]`] = supp;\n    });\n  }\n  \n  // Check if comments indicate prescription and add to supplements if needed\n  const comments = row['Comments'] || '';\n  if (row['Medicine Supplement'] === 'Yes' && comments.toLowerCase().includes('prescription')) {\n    // Check if Prescription Medicine not already in supplements\n    if (!suppTypes.includes('Prescription Medicine')) {\n      const currentSupps = suppTypes ? suppTypes.split(',').filter(s => s.trim()).length : 0;\n      formData[`submission[7][${currentSupps}]`] = 'Prescription Medicine';\n    }\n  }\n  \n  // Additional comments (field 21)\n  formData['submission[21]'] = comments;\n  \n  results.push({\n    json: {\n      dogName: row['Dog Name'],\n      parentEmail: row['Parent Email'],\n      formData: formData,\n      formId: FORM_ID\n    }\n  });\n}\n\nreturn results;"
      },
