    {
      "parameters": {
        "jsCode": "// Count successful submissions\nconst items = $input.all();\nlet successCount = 0;\nlet failCount = 0;\nconst errors = [];\n\nfor (const item of items) {\n  const response = item.json;\n  if (response.responseCode === 200 || response.responseCode === '200' || response.content?.submissionID) {\n    successCount++;\n  } else {\n    failCount++;\n    errors.push(response.message || 'Unknown error');\n  }\n}\n\nreturn [{\n  json: {\n    successCount,\n    failCount,\n    totalProcessed: items.length,\n    errors: errors.slice(0, 5) // Limit error messages\n  }\n}];"
      },
